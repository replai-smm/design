{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://replai-smm.ru/schema/design/1/tokens.json",
  "title": "Роли цвета и шкалы",
  "$comment": "tokens.json — роли цвета обеих тем и словарь тонов; scale.json ($defs/scale) — отступы, высоты, текст, шрифт, углы, глубина, движение. Списки закрыты: новая роль или шаг — правка этой схемы.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "doc",
    "colors",
    "tones",
    "font"
  ],
  "properties": {
    "doc": {
      "const": "роли цвета"
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canvas",
        "surface",
        "inverse",
        "inverse-hover",
        "fg",
        "fg-muted",
        "fg-disabled",
        "fg-inverse",
        "line",
        "line-strong",
        "hover",
        "selected",
        "accent",
        "scrim",
        "shadow",
        "danger",
        "danger-fg",
        "danger-bg",
        "warning",
        "warning-fg",
        "warning-bg",
        "success",
        "decision",
        "decision-fg",
        "decision-bg",
        "danger-fill",
        "warning-fill",
        "neutral-fill",
        "success-fill",
        "decision-fill",
        "series-1",
        "series-2",
        "series-3",
        "series-4",
        "series-5",
        "series-6"
      ],
      "properties": {
        "canvas": {
          "$ref": "#/$defs/color"
        },
        "surface": {
          "$ref": "#/$defs/color"
        },
        "inverse": {
          "$ref": "#/$defs/color"
        },
        "inverse-hover": {
          "$ref": "#/$defs/color"
        },
        "fg": {
          "$ref": "#/$defs/color"
        },
        "fg-muted": {
          "$ref": "#/$defs/color"
        },
        "fg-disabled": {
          "$ref": "#/$defs/color"
        },
        "fg-inverse": {
          "$ref": "#/$defs/color"
        },
        "line": {
          "$ref": "#/$defs/color"
        },
        "line-strong": {
          "$ref": "#/$defs/color"
        },
        "hover": {
          "$ref": "#/$defs/color"
        },
        "selected": {
          "$ref": "#/$defs/color"
        },
        "accent": {
          "$ref": "#/$defs/color"
        },
        "scrim": {
          "$ref": "#/$defs/color"
        },
        "shadow": {
          "$ref": "#/$defs/color"
        },
        "danger": {
          "$ref": "#/$defs/color"
        },
        "danger-fg": {
          "$ref": "#/$defs/color"
        },
        "danger-bg": {
          "$ref": "#/$defs/color"
        },
        "warning": {
          "$ref": "#/$defs/color"
        },
        "warning-fg": {
          "$ref": "#/$defs/color"
        },
        "warning-bg": {
          "$ref": "#/$defs/color"
        },
        "success": {
          "$ref": "#/$defs/color"
        },
        "decision": {
          "$ref": "#/$defs/color"
        },
        "decision-fg": {
          "$ref": "#/$defs/color"
        },
        "decision-bg": {
          "$ref": "#/$defs/color"
        },
        "danger-fill": {
          "$ref": "#/$defs/color"
        },
        "warning-fill": {
          "$ref": "#/$defs/color"
        },
        "neutral-fill": {
          "$ref": "#/$defs/color"
        },
        "success-fill": {
          "$ref": "#/$defs/color"
        },
        "decision-fill": {
          "$ref": "#/$defs/color"
        },
        "series-1": {
          "$ref": "#/$defs/color"
        },
        "series-2": {
          "$ref": "#/$defs/color"
        },
        "series-3": {
          "$ref": "#/$defs/color"
        },
        "series-4": {
          "$ref": "#/$defs/color"
        },
        "series-5": {
          "$ref": "#/$defs/color"
        },
        "series-6": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "tones": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "опасно",
        "решение",
        "внимание",
        "инфо",
        "нейтрально",
        "хорошо"
      ],
      "properties": {
        "опасно": {
          "$ref": "#/$defs/tone"
        },
        "решение": {
          "$ref": "#/$defs/tone"
        },
        "внимание": {
          "$ref": "#/$defs/tone"
        },
        "инфо": {
          "$ref": "#/$defs/tone"
        },
        "нейтрально": {
          "$ref": "#/$defs/tone"
        },
        "хорошо": {
          "$ref": "#/$defs/tone"
        }
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sans",
        "mono"
      ],
      "properties": {
        "sans": {
          "$ref": "#/$defs/fontFiles"
        },
        "mono": {
          "$ref": "#/$defs/fontFiles"
        }
      }
    }
  },
  "$defs": {
    "word": {
      "type": "string",
      "minLength": 1
    },
    "hex": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}(?:[0-9a-f]{2})?$"
    },
    "rem": {
      "type": "string",
      "pattern": "^\\d*\\.?\\d+rem$"
    },
    "roleName": {
      "enum": [
        "canvas",
        "surface",
        "inverse",
        "inverse-hover",
        "fg",
        "fg-muted",
        "fg-disabled",
        "fg-inverse",
        "line",
        "line-strong",
        "hover",
        "selected",
        "accent",
        "scrim",
        "shadow",
        "danger",
        "danger-fg",
        "danger-bg",
        "warning",
        "warning-fg",
        "warning-bg",
        "success",
        "decision",
        "decision-fg",
        "decision-bg",
        "danger-fill",
        "warning-fill",
        "neutral-fill",
        "success-fill",
        "decision-fill",
        "series-1",
        "series-2",
        "series-3",
        "series-4",
        "series-5",
        "series-6"
      ]
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "light",
        "dark",
        "role"
      ],
      "properties": {
        "light": {
          "$ref": "#/$defs/hex"
        },
        "dark": {
          "$ref": "#/$defs/hex"
        },
        "role": {
          "$ref": "#/$defs/word"
        }
      }
    },
    "tone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "mark",
        "text",
        "bg",
        "fill"
      ],
      "properties": {
        "key": {
          "enum": [
            "danger",
            "decision",
            "warning",
            "info",
            "neutral",
            "success"
          ]
        },
        "mark": {
          "$ref": "#/$defs/roleName"
        },
        "text": {
          "$ref": "#/$defs/roleName"
        },
        "bg": {
          "anyOf": [
            {
              "$ref": "#/$defs/roleName"
            },
            {
              "type": "null"
            }
          ]
        },
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/roleName"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "fontFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "files"
      ],
      "properties": {
        "family": {
          "$ref": "#/$defs/word"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^fonts/[A-Za-z-]+\\.woff2$"
          }
        }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "role"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/rem"
        },
        "role": {
          "$ref": "#/$defs/word"
        }
      }
    },
    "textRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "line",
        "weight",
        "role"
      ],
      "properties": {
        "size": {
          "$ref": "#/$defs/rem"
        },
        "line": {
          "$ref": "#/$defs/rem"
        },
        "weight": {
          "enum": [
            400,
            600
          ]
        },
        "family": {
          "const": "mono"
        },
        "role": {
          "$ref": "#/$defs/word"
        }
      }
    },
    "fontStack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/word"
          }
        }
      }
    },
    "radius": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "role"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^\\d+px$"
        },
        "role": {
          "$ref": "#/$defs/word"
        }
      }
    },
    "elevation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "role"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^(none|[0-9a-z .]+\\{shadow\\})$"
        },
        "role": {
          "$ref": "#/$defs/word"
        }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc",
        "space",
        "size",
        "measure",
        "text",
        "font",
        "radius",
        "elevation",
        "motion"
      ],
      "properties": {
        "doc": {
          "const": "шкалы"
        },
        "space": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tight",
            "items",
            "compact",
            "blocks",
            "groups",
            "sections"
          ],
          "properties": {
            "tight": {
              "$ref": "#/$defs/space"
            },
            "items": {
              "$ref": "#/$defs/space"
            },
            "compact": {
              "$ref": "#/$defs/space"
            },
            "blocks": {
              "$ref": "#/$defs/space"
            },
            "groups": {
              "$ref": "#/$defs/space"
            },
            "sections": {
              "$ref": "#/$defs/space"
            }
          }
        },
        "size": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "icon",
            "dense",
            "control",
            "touch"
          ],
          "properties": {
            "icon": {
              "$ref": "#/$defs/space"
            },
            "dense": {
              "$ref": "#/$defs/space"
            },
            "control": {
              "$ref": "#/$defs/space"
            },
            "touch": {
              "$ref": "#/$defs/space"
            }
          }
        },
        "measure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "number",
            "rail",
            "hint",
            "narrow",
            "popup",
            "form",
            "panel",
            "wide",
            "window",
            "page"
          ],
          "properties": {
            "number": {
              "$ref": "#/$defs/space"
            },
            "rail": {
              "$ref": "#/$defs/space"
            },
            "hint": {
              "$ref": "#/$defs/space"
            },
            "narrow": {
              "$ref": "#/$defs/space"
            },
            "popup": {
              "$ref": "#/$defs/space"
            },
            "form": {
              "$ref": "#/$defs/space"
            },
            "panel": {
              "$ref": "#/$defs/space"
            },
            "wide": {
              "$ref": "#/$defs/space"
            },
            "window": {
              "$ref": "#/$defs/space"
            },
            "page": {
              "$ref": "#/$defs/space"
            }
          }
        },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "caption",
            "body",
            "heading",
            "reading",
            "code",
            "title",
            "page"
          ],
          "properties": {
            "caption": {
              "$ref": "#/$defs/textRole"
            },
            "body": {
              "$ref": "#/$defs/textRole"
            },
            "heading": {
              "$ref": "#/$defs/textRole"
            },
            "reading": {
              "$ref": "#/$defs/textRole"
            },
            "code": {
              "$ref": "#/$defs/textRole"
            },
            "title": {
              "$ref": "#/$defs/textRole"
            },
            "page": {
              "$ref": "#/$defs/textRole"
            }
          }
        },
        "font": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sans",
            "mono"
          ],
          "properties": {
            "sans": {
              "$ref": "#/$defs/fontStack"
            },
            "mono": {
              "$ref": "#/$defs/fontStack"
            }
          }
        },
        "radius": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "control",
            "surface",
            "full"
          ],
          "properties": {
            "control": {
              "$ref": "#/$defs/radius"
            },
            "surface": {
              "$ref": "#/$defs/radius"
            },
            "full": {
              "$ref": "#/$defs/radius"
            }
          }
        },
        "elevation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "flat",
            "raised",
            "overlay"
          ],
          "properties": {
            "flat": {
              "$ref": "#/$defs/elevation"
            },
            "raised": {
              "$ref": "#/$defs/elevation"
            },
            "overlay": {
              "$ref": "#/$defs/elevation"
            }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fast",
            "move",
            "ease"
          ],
          "properties": {
            "fast": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "role"
              ],
              "properties": {
                "value": {
                  "const": "110ms"
                },
                "role": {
                  "$ref": "#/$defs/word"
                }
              }
            },
            "move": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "role"
              ],
              "properties": {
                "value": {
                  "const": "600ms"
                },
                "role": {
                  "$ref": "#/$defs/word"
                }
              }
            },
            "ease": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "role"
              ],
              "properties": {
                "value": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number"
                  }
                },
                "role": {
                  "$ref": "#/$defs/word"
                }
              }
            }
          }
        }
      }
    }
  }
}
