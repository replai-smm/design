{
  "doc": "роли цвета",
  "colors": {
    "canvas": {
      "light": "#f4f4f4",
      "dark": "#0f0f11",
      "role": "холст страницы; утопленное на поверхности (код, выходной день)"
    },
    "surface": {
      "light": "#ffffff",
      "dark": "#17171a",
      "role": "поверхность: карточка, колонка, поле, окно"
    },
    "inverse": {
      "light": "#161616",
      "dark": "#ececec",
      "role": "главное действие и подсказка: инверсия, не цвет"
    },
    "inverse-hover": {
      "light": "#393939",
      "dark": "#c6c6c6",
      "role": "главное действие под указателем"
    },
    "fg": {
      "light": "#161616",
      "dark": "#ececec",
      "role": "текст и значки"
    },
    "fg-muted": {
      "light": "#525252",
      "dark": "#a1a1aa",
      "role": "второй текст: подпись, подсказка, плейсхолдер"
    },
    "fg-disabled": {
      "light": "#a8a8a8",
      "dark": "#5a5a60",
      "role": "выключенное"
    },
    "fg-inverse": {
      "light": "#ffffff",
      "dark": "#0f0f11",
      "role": "текст на инверсии"
    },
    "line": {
      "light": "#e0e0e0",
      "dark": "#2a2a2f",
      "role": "тихая рамка: край поверхности, разделитель, скелет"
    },
    "line-strong": {
      "light": "#8d8d8d",
      "dark": "#6f6f76",
      "role": "граница того, что нажимают и заполняют: поле, тихая кнопка, галочка"
    },
    "hover": {
      "light": "#8d8d8d1f",
      "dark": "#8d8d8d29",
      "role": "под указателем — поверх любой поверхности"
    },
    "selected": {
      "light": "#8d8d8d33",
      "dark": "#8d8d8d3d",
      "role": "выбрано: вкладка, фильтр, открытая строка, пункт списка"
    },
    "accent": {
      "light": "#0f62fe",
      "dark": "#78a9ff",
      "role": "единственный синий: ссылка и фокус"
    },
    "scrim": {
      "light": "#16161680",
      "dark": "#000000b3",
      "role": "затемнение под окном"
    },
    "shadow": {
      "light": "#0000002e",
      "dark": "#000000a6",
      "role": "тень всплывающего и окна"
    },
    "danger": {
      "light": "#da1e28",
      "dark": "#fa4d56",
      "role": "знак тона «опасно»"
    },
    "danger-fg": {
      "light": "#a2191f",
      "dark": "#ffb3b8",
      "role": "текст тона «опасно»: ошибка поля, «не отправлено»"
    },
    "danger-bg": {
      "light": "#fff1f1",
      "dark": "#331417",
      "role": "подложка тона «опасно»: метка, клетка сетки"
    },
    "warning": {
      "light": "#b28600",
      "dark": "#f1c21b",
      "role": "знак тона «внимание»"
    },
    "warning-fg": {
      "light": "#684e00",
      "dark": "#fddc69",
      "role": "текст тона «внимание» на его подложке"
    },
    "warning-bg": {
      "light": "#fcf4d6",
      "dark": "#2e2608",
      "role": "подложка тона «внимание»"
    },
    "success": {
      "light": "#198038",
      "dark": "#42be65",
      "role": "знак тона «хорошо»; подложки нет — норма не кричит"
    },
    "danger-fill": {
      "light": "#ffd7d9",
      "dark": "#5a1d22",
      "role": "заливка статуса «опасно» (пропуск): только сетка статуса"
    },
    "warning-fill": {
      "light": "#fcf4d6",
      "dark": "#433609",
      "role": "заливка статуса «внимание» (недобор): только сетка статуса"
    },
    "neutral-fill": {
      "light": "#e0e0e0",
      "dark": "#35353b",
      "role": "заливка статуса «нейтрально» (сверх плана): только сетка статуса"
    },
    "success-fill": {
      "light": "#a7f0ba",
      "dark": "#133e23",
      "role": "заливка статуса «хорошо» (план выполнен): только сетка статуса"
    },
    "decision": {
      "light": "#8a3ffc",
      "dark": "#be95ff",
      "role": "знак тона «решение»"
    },
    "decision-fg": {
      "light": "#6929c4",
      "dark": "#d4bbff",
      "role": "текст тона «решение» на его подложке"
    },
    "decision-bg": {
      "light": "#f6f2ff",
      "dark": "#251a3d",
      "role": "подложка тона «решение»"
    },
    "decision-fill": {
      "light": "#f6f2ff",
      "dark": "#251a3d",
      "role": "заливка статуса «решение»: только сетка статуса"
    },
    "series-1": {
      "light": "#6929c4",
      "dark": "#a56eff",
      "role": "ряд данных 1"
    },
    "series-2": {
      "light": "#1192e8",
      "dark": "#33b1ff",
      "role": "ряд данных 2"
    },
    "series-3": {
      "light": "#005d5d",
      "dark": "#08bdba",
      "role": "ряд данных 3"
    },
    "series-4": {
      "light": "#9f1853",
      "dark": "#ff7eb6",
      "role": "ряд данных 4"
    },
    "series-5": {
      "light": "#8a3800",
      "dark": "#ba4e00",
      "role": "ряд данных 5"
    },
    "series-6": {
      "light": "#6f6f6f",
      "dark": "#8d8d8d",
      "role": "ряд данных 6: прочее"
    }
  },
  "tones": {
    "опасно": {
      "key": "danger",
      "mark": "danger",
      "text": "danger-fg",
      "bg": "danger-bg",
      "fill": "danger-fill"
    },
    "решение": {
      "key": "decision",
      "mark": "decision",
      "text": "decision-fg",
      "bg": "decision-bg",
      "fill": "decision-fill"
    },
    "внимание": {
      "key": "warning",
      "mark": "warning",
      "text": "warning-fg",
      "bg": "warning-bg",
      "fill": "warning-fill"
    },
    "инфо": {
      "key": "info",
      "mark": "fg",
      "text": "fg",
      "bg": null,
      "fill": null
    },
    "нейтрально": {
      "key": "neutral",
      "mark": "fg-muted",
      "text": "fg",
      "bg": null,
      "fill": "neutral-fill"
    },
    "хорошо": {
      "key": "success",
      "mark": "success",
      "text": "fg",
      "bg": null,
      "fill": "success-fill"
    }
  },
  "font": {
    "sans": {
      "family": "IBM Plex Sans",
      "files": [
        "fonts/IBMPlexSans-Regular.woff2",
        "fonts/IBMPlexSans-SemiBold.woff2"
      ]
    },
    "mono": {
      "family": "IBM Plex Mono",
      "files": [
        "fonts/IBMPlexMono-Regular.woff2"
      ]
    }
  }
}
