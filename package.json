{
  "name": "@replai-smm/design",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Дизайн-система replai-smm: роли и шкалы, ДС-React по уровням, правила машиной. Продукты ставят по тегу: github:replai-smm/design#vX.Y.Z (в теге лежит собранный dist/).",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "react"
  ],
  "exports": {
    ".": "./react/src/index.ts",
    "./styles.css": "./react/src/ds.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens": "./dist/tokens.ts",
    "./tokens.json": "./tokens.json",
    "./scale.json": "./scale.json",
    "./statuses.json": "./statuses.json",
    "./matrix.yaml": "./matrix.yaml",
    "./fonts/*": "./fonts/*",
    "./lint": "./lint/principles.mjs",
    "./lint/cli": "./lint/cli.mjs",
    "./lint/eslint-plugin": "./lint/eslint-plugin.mjs",
    "./lint/scan": "./lint/scan.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fonts",
    "licenses",
    "lint",
    "react/src",
    "!react/src/**/__tests__",
    "!react/src/**/*.stories.tsx",
    "!react/src/stories",
    "tokens.json",
    "scale.json",
    "statuses.json",
    "statuses.schema.json",
    "tokens.schema.json",
    "matrix.schema.json",
    "matrix.yaml",
    "NOTICE.md",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "pretest": "node build.mjs",
    "test": "npm run test:design && npm test -w react",
    "test:design": "vitest run -c vitest.config.ts",
    "test:visual": "npm run storybook:build && npm run visual -w react",
    "typecheck": "npm run typecheck -w react",
    "lint": "npm run lint -w react",
    "storybook": "npm run storybook -w react",
    "storybook:build": "npm run storybook:build -w react",
    "check": "node build.mjs && npm run typecheck && npm run lint && npm test && npm run test:visual"
  },
  "peerDependencies": {
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "vitest": "^4.1.7",
    "yaml": "^2.9.1"
  }
}
