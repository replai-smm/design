{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://replai-smm.ru/schema/design/1/statuses.json",
  "title": "Статусы",
  "$comment": "Закрытый список статусов: слово — x-say закона Карты (сверяет process), тон — слово словаря тонов tokens.json → tones.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "doc",
    "source",
    "axes",
    "statuses"
  ],
  "properties": {
    "doc": {
      "const": "статусы"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work",
        "change"
      ],
      "properties": {
        "work": {
          "type": "string",
          "minLength": 1
        },
        "change": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "statuses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "axis",
          "value",
          "say",
          "tone"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(work|change)\\.[a-z-]+$"
          },
          "axis": {
            "enum": [
              "work",
              "change"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "say": {
            "type": "string",
            "minLength": 1
          },
          "tone": {
            "enum": [
              "опасно",
              "внимание",
              "инфо",
              "нейтрально",
              "хорошо"
            ]
          }
        }
      }
    }
  }
}
