{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://replai-smm.ru/schema/karta/3/design/statuses.json",
  "title": "Статусы дизайн-системы",
  "$comment": "Shape of process/design/statuses.json: the closed list of statuses the dashboard and products paint. Words come from x-say of the law schema (test design/__tests__/statuses.test.ts); tone — one of the four of tokens.json → palettes.product (product UIs); karta — one of the three of palettes.karta (Karta screens and dashboard, KARTA-VIEW C-SCR-3) or null: no state colour.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "doc",
    "source",
    "tones",
    "karta",
    "statuses"
  ],
  "properties": {
    "doc": {
      "const": "статусы"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "tones": {
      "const": [
        "опасно",
        "внимание",
        "хорошо",
        "нейтрально"
      ]
    },
    "karta": {
      "const": [
        "без изменений",
        "хотят изменить",
        "падает"
      ]
    },
    "statuses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "axis",
          "value",
          "say",
          "tone",
          "karta"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+\\.[a-z][a-z-]*$"
          },
          "axis": {
            "enum": [
              "work",
              "change"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "say": {
            "type": "string",
            "minLength": 1
          },
          "tone": {
            "enum": [
              "опасно",
              "внимание",
              "хорошо",
              "нейтрально"
            ]
          },
          "karta": {
            "enum": [
              "без изменений",
              "хотят изменить",
              "падает",
              null
            ]
          }
        }
      }
    }
  }
}
