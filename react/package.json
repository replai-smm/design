{
  "name": "@replai-smm/design-react",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "ДС-React (рабочее пространство репо design): исходники — react/src, их отдаёт корневой пакет @replai-smm/design. Здесь — Storybook, тесты, типы, снимки облика.",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/ds.css"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "node ../lint/cli.mjs src .storybook && node ../lint/principles.mjs --kind ds --strict src .storybook",
    "storybook": "storybook dev -p 6007",
    "storybook:build": "storybook build -o storybook-static",
    "showcase": "SHOWCASE_WRITE=1 vitest run src/__tests__/showcase.test.tsx",
    "check": "npm run typecheck && npm run lint && npm test",
    "visual": "node visual/run.mjs",
    "visual:update": "node visual/run.mjs --update"
  },
  "devDependencies": {
    "@carbon/icons": "11.90.0",
    "@storybook/react-vite": "^10.5.7",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.10.3",
    "jsdom": "^29.1.1",
    "pixelmatch": "7.1.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.7"
  }
}
